# Copiez ce fichier en .env, puis remplacez chaque remplacez-moi (exercices 1.2, 1.3 et 2.1).
# Le fichier .env est un secret : il n'est jamais suivi par Git.
# Clé au hasard : python3 -c "import secrets; print('sk-' + secrets.token_hex(16))"

# Les deux valeurs de la gateway du cours, données par votre formateur
GATEWAY_BASE_URL=remplacez-moi
GATEWAY_API_KEY=remplacez-moi

# LiteLLM : LLM_API_KEY prend la même valeur que LITELLM_MASTER_KEY
LITELLM_MASTER_KEY=sk-remplacez-moi
LLM_BASE_URL=http://localhost:4000
LLM_API_KEY=sk-remplacez-moi
CHAT_MODEL=chat
EMBED_MODEL=embed-small

QDRANT_URL=http://localhost:6333

# MinIO et PostgreSQL : deux valeurs au hasard
MINIO_USER=rag
MINIO_PASSWORD=remplacez-moi
MINIO_URL=localhost:9000
POSTGRES_PASSWORD=remplacez-moi
POSTGRES_URL=postgresql://rag:${POSTGRES_PASSWORD}@localhost:5432/catalog
